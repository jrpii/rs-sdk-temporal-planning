# Local experiment runtime.
# Use with:
#   cd server/engine
#   bun --env-file=.env.experiment run src/app.ts

# 2004/realtime-ish server settings.
NODE_TICKRATE=600
NODE_XPRATE=1
NODE_PROFILE=experiments
NODE_RANDOM_EVENTS=false
NODE_DEBUG=true
NODE_DEBUG_SOCKET=true

# Planner-loop experiments intentionally ignore run energy for now.
NODE_INFINITE_RUN=true

# Local web/game ports.
WEB_PORT=8888
WEB_MANAGEMENT_PORT=8898
NODE_PORT=43594

# Local sqlite default.
DB_BACKEND=sqlite
